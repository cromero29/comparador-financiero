// Prisma Schema para Comparador Financiero MVP
// Base de datos: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENTIDADES FINANCIERAS
// ============================================

model EntidadFinanciera {
  id        String   @id @default(uuid())
  codigo    String   @unique // BANCOLOMBIA, DAVIVIENDA, etc.
  nombre    String
  tipo      TipoEntidad
  logo      String?
  sitioWeb  String
  activa    Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  productos       Producto[]
  scrapersConfigs ScraperConfig[]
  
  @@map("entidades_financieras")
}

enum TipoEntidad {
  BANCO
  FINTECH
  COOPERATIVA
  OTRA
}

// ============================================
// PRODUCTOS FINANCIEROS
// ============================================

model Producto {
  id          String   @id @default(uuid())
  entidadId   String
  
  // Información básica
  nombre      String
  tipo        TipoProducto
  descripcion String?
  
  // Condiciones financieras
  tasaNominalMensual Decimal  @db.Decimal(10, 4) // 1.50%
  tasaNominalAnual   Decimal  @db.Decimal(10, 4) // 18.00%
  tasaEfectivaAnual  Decimal  @db.Decimal(10, 4) // 19.56%
  
  // Rangos
  montoMinimo    Decimal  @db.Decimal(15, 2) // 1,000,000
  montoMaximo    Decimal  @db.Decimal(15, 2) // 100,000,000
  plazoMinimoMeses Int    // 6
  plazoMaximoMeses Int    // 84
  
  // Costos adicionales
  costoEstudio        Decimal @db.Decimal(15, 2) @default(0)
  costoAdministracion Decimal @db.Decimal(10, 4) @default(0) // % mensual
  seguroVida          Decimal @db.Decimal(10, 4) @default(0) // % mensual
  seguroDesempleo     Decimal @db.Decimal(10, 4) @default(0) // % mensual
  
  // Requisitos
  edadMinima      Int     @default(18)
  edadMaxima      Int     @default(75)
  ingresoMinimo   Decimal @db.Decimal(15, 2)
  
  requiereCuentaNomina  Boolean @default(false)
  aceptaIndependientes  Boolean @default(true)
  aceptaPensionados     Boolean @default(true)
  
  // URLs
  urlInformacion String
  urlSolicitud   String
  
  // Estado
  activo      Boolean  @default(true)
  verificado  Boolean  @default(false) // Verificado por scraping
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  entidad     EntidadFinanciera @relation(fields: [entidadId], references: [id])
  
  @@index([entidadId])
  @@index([tipo, activo])
  @@index([montoMinimo, montoMaximo])
  @@map("productos")
}

enum TipoProducto {
  LIBRE_INVERSION
  COMPRA_CARTERA
}

// ============================================
// WEB SCRAPING
// ============================================

model ScraperConfig {
  id          String   @id @default(uuid())
  entidadId   String
  tipo        TipoProducto
  
  // Configuración del scraper
  url         String
  estrategia  EstrategiaScrap // static o dynamic
  
  // Selectores CSS (JSON)
  selectores  Json // { tasaMensual: '.tasa', monto: '.monto', ... }
  
  // Configuración avanzada
  waitForSelector String? // Selector para esperar antes de scrapear
  timeout         Int     @default(30000) // ms
  
  // Estado
  activo      Boolean  @default(true)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  entidad     EntidadFinanciera @relation(fields: [entidadId], references: [id])
  logs        ScrapingLog[]
  
  @@unique([entidadId, tipo])
  @@index([entidadId])
  @@map("scraper_configs")
}

enum EstrategiaScrap {
  STATIC   // Cheerio (HTML estático)
  DYNAMIC  // Puppeteer (JavaScript)
}

model ScrapingLog {
  id              String   @id @default(uuid())
  scraperConfigId String
  
  // Resultado
  exitoso         Boolean
  productosEncontrados Int  @default(0)
  
  // Errores
  error           String?  @db.Text
  
  // Metadata
  duracionMs      Int
  
  // Timestamp
  fecha           DateTime @default(now())
  
  // Relaciones
  scraperConfig   ScraperConfig @relation(fields: [scraperConfigId], references: [id])
  
  @@index([scraperConfigId, fecha])
  @@index([fecha])
  @@map("scraping_logs")
}

// ============================================
// TRACKING (Preparado para monetización)
// ============================================

// Sesiones de usuario (agrupador principal)
model Sesion {
  id              String   @id @default(uuid())
  
  // Identificación
  fingerprint     String?  // Huella digital del navegador
  ipAddress       String?
  userAgent       String?
  
  // Contexto geográfico
  pais            String?
  ciudad          String?
  
  // Contexto técnico
  dispositivo     String?  // desktop, mobile, tablet
  navegador       String?  // chrome, firefox, safari
  sistemaOperativo String?
  
  // Origen de tráfico (UTM)
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  
  // Referrer
  referrer        String?
  
  // Timestamps
  inicioSesion    DateTime @default(now())
  ultimaActividad DateTime @default(now())
  
  // Relaciones
  busquedas       Busqueda[]
  clics           ClicTracking[]
  eventos         EventoTracking[]
  
  @@index([fingerprint])
  @@index([inicioSesion])
  @@map("sesiones")
}

// Búsquedas realizadas (captura TODOS los parámetros)
model Busqueda {
  id                String   @id @default(uuid())
  
  // Relación con sesión
  sesionId          String
  
  // Parámetros de búsqueda
  tipoProducto      TipoProducto
  montoSolicitado   Decimal  @db.Decimal(15, 2)
  plazoMeses        Int
  ingresos          Decimal  @db.Decimal(15, 2)
  edad              Int
  tipoEmpleo        String   // dependiente, independiente, pensionado
  
  // Parámetros adicionales (compra de cartera)
  deudaActual       Decimal? @db.Decimal(15, 2)
  cuotaActual       Decimal? @db.Decimal(15, 2)
  tasaActual        Decimal? @db.Decimal(10, 4)
  
  // Resultados de la búsqueda
  ofertasEncontradas Int
  mejorTasa          Decimal  @db.Decimal(10, 4)
  mejorCuota         Decimal  @db.Decimal(15, 2)
  
  // Top 3 entidades mostradas (para análisis)
  entidad1Id        String?
  entidad2Id        String?
  entidad3Id        String?
  
  // Métricas de engagement
  tiempoEnResultados Int?     // segundos que pasó viendo resultados
  ofertasExpandidas  Int      @default(0) // cuántas tarjetas expandió
  
  // Conversión
  generoClic        Boolean  @default(false)
  clicsGenerados    Int      @default(0)
  
  // Timestamp
  fecha             DateTime @default(now())
  
  // Relaciones
  sesion            Sesion   @relation(fields: [sesionId], references: [id])
  
  @@index([sesionId, fecha])
  @@index([tipoProducto, fecha])
  @@index([montoSolicitado, plazoMeses])
  @@index([edad, ingresos])
  @@index([generoClic])
  @@map("busquedas")
}

model EventoTracking {
  id          String   @id @default(uuid())
  
  // Session
  sesionId    String
  
  // Evento
  tipoEvento  String   // form_start, form_complete, offer_view, offer_expand, etc.
  categoria   String   // busqueda, oferta, navegacion, error
  accion      String   // click, view, expand, submit
  etiqueta    String?  // información adicional
  
  // Metadata (JSON flexible)
  metadata    Json?
  
  // Contexto
  url         String?
  pathname    String?
  
  // Timestamp
  fecha       DateTime @default(now())
  
  // Relaciones
  sesion      Sesion   @relation(fields: [sesionId], references: [id])
  
  @@index([sesionId, fecha])
  @@index([tipoEvento, fecha])
  @@index([categoria, accion])
  @@map("eventos_tracking")
}

model ClicTracking {
  id                  String   @id @default(uuid())
  
  // Relación con sesión y búsqueda
  sesionId            String
  busquedaId          String?  // Opcional por si viene de otra fuente
  
  // Información del producto clickeado
  productoId          String
  entidadId           String
  entidadNombre       String   // Desnormalizado para queries rápidas
  entidadTipo         TipoEntidad
  
  // Contexto del clic
  posicion            Int      // Posición en ranking (1-10)
  paginaResultados    Int      @default(1) // En qué página estaba (1 o 2)
  
  // Parámetros de la oferta clickeada
  montoSolicitado     Decimal  @db.Decimal(15, 2)
  plazoMeses          Int
  tipoProducto        TipoProducto
  tasaOfrecida        Decimal  @db.Decimal(10, 4)
  cuotaOfrecida       Decimal  @db.Decimal(15, 2)
  
  // Información del usuario (para segmentación)
  edad                Int
  ingresos            Decimal  @db.Decimal(15, 2)
  tipoEmpleo          String
  
  // Monetización (preparado para CPC/CPL)
  costoClic           Decimal  @db.Decimal(10, 2) @default(0)
  esConversion        Boolean  @default(false) // Si confirmamos que aplicó
  valorConversion     Decimal? @db.Decimal(10, 2) // CPL
  
  // Resultado de la redirección
  redireccionExitosa  Boolean
  urlDestino          String
  
  // Timestamp
  fecha               DateTime @default(now())
  
  // Relaciones
  sesion              Sesion   @relation(fields: [sesionId], references: [id])
  
  @@index([productoId, fecha])
  @@index([entidadId, fecha])
  @@index([sesionId])
  @@index([fecha])
  @@index([tipoProducto, montoSolicitado])
  @@index([posicion])
  @@map("clics_tracking")
}
